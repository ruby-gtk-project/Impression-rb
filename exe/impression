#!/usr/bin/env ruby
# frozen_string_literal: true

require "impression"

# GApplication parses the argument list itself: it turns the paths into the
# files the "open" signal carries and consumes its own options, such as the
# --gapplication-service the D-Bus service file launches the app with.
Impression::Application.new.build.run([$PROGRAM_NAME, *ARGV])
